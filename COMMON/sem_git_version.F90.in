! Auto-generated by CMake (GenerateGitVersion.cmake) at build time -- do not edit.
! Regenerated whenever .git/HEAD or .git/index changes, so it always reflects the
! commit (and working-tree dirty/clean status) that was actually compiled, even
! though the resulting executable typically runs from a directory outside the repo.
module sem_git_version
    implicit none
    character(len=*), parameter :: SEM_GIT_HASH  = "@GIT_HASH@"
    character(len=*), parameter :: SEM_GIT_DIRTY = "@GIT_DIRTY@"
end module sem_git_version
