!! ============================================================================
!! D4 SCAFFOLD -- solid <-> fluid-aniso coupling for SEM2D (Phase 2, Block D4).
!!
!! STATUS: UNVERIFIED, NOT in CMakeLists on purpose (so it cannot break the build
!! of the working Blocks A-D3-D5). This is a starting point for the cluster work,
!! NOT a finished module. Filename ends in ".scaffold" -- rename to .F90 and add to
!! SEM2D/CMakeLists.txt only when integrating D4.
!!
!! PREREQUISITE (D4.0, NOT done): the solid displacement and the fluid potential must
!! NOT share the same DOF at changing_media (solid<->fluid) faces/vertices. With the
!! current approach A (phi in component 0, shared CG face/vertex objects) the assembly
!! SUMS Ux(solid)+phi(fluid) at the interface -> WRONG. This coupling operator is only
!! correct AFTER the interface DOFs are separated (global_numbering split). Until then
!! it must NOT be wired into Newmark.
!!
!! PHYSICS (mirror of SEM3D solid_fluid_coupling.f90, anisotropy-agnostic at the
!! interface -- rho^-1 lives only in the volume kernel):
!!   StoF: ForcesFl_fluid(idxF) += sum_j BtN(j) * Veloc_solid(idxS,j)
!!   FtoS: Veloc_solid(idxS,j)  += BtN(j) * VelPhi_fluid(idxF)        [VelPhi = -pressure]
!! BtN = outward unit normal (solid->fluid) * line-Jacobian * GLL weight on the face.
!!
!! TODOs flagged inline with !!TODO: are the SEM2D-specific bits to confirm on cluster.
!! ============================================================================
module solid_fluid_coupling_2d

    use constants
    use sdomain
    use selement
    implicit none

    type sf_iface_2d
        integer :: nface = -1            ! the changing_media face
        integer :: e_sol = -1, e_flu = -1   ! solid-side, fluid-side element
        integer :: wf_sol = -1, wf_flu = -1 ! which local face on each element
        integer :: ngll = 0
        ! local element (i,j) indices of the face GLL points, per side:
        integer, allocatable :: is_sol(:), js_sol(:)
        integer, allocatable :: is_flu(:), js_flu(:)
        real(fpp), allocatable :: BtN(:,:) ! (0:1,0:ngll-1) outward normal * lineJac * weight
    end type sf_iface_2d

    type(sf_iface_2d), allocatable :: sfi(:)
    integer :: n_sfi = 0

contains

    !-----------------------------------------------------------------------
    !> Enumerate solid<->fluid-aniso interface faces and build BtN + the per-side
    !! face-GLL -> element-(i,j) maps. Call once at init (after define_arrays).
    subroutine build_sf_interface_2d(Tdomain)
        type(domain), intent(inout) :: Tdomain
        integer :: nf, e0, e1, esol, eflu, nfound, k
        logical :: a0, a1

        ! count
        nfound = 0
        do nf = 0, Tdomain%n_face-1
            if (.not. Tdomain%sFace(nf)%changing_media) cycle
            e0 = Tdomain%sFace(nf)%Near_Element(0)
            e1 = Tdomain%sFace(nf)%Near_Element(1)
            if (e0 < 0 .or. e1 < 0) cycle
            ! fluid-aniso side = the one with AcoeffFl allocated
            a0 = allocated(Tdomain%specel(e0)%AcoeffFl)
            a1 = allocated(Tdomain%specel(e1)%AcoeffFl)
            if (a0 .eqv. a1) cycle   ! need exactly one fluid-aniso side
            nfound = nfound + 1
        end do
        n_sfi = nfound
        if (n_sfi == 0) return
        allocate(sfi(n_sfi))

        k = 0
        do nf = 0, Tdomain%n_face-1
            if (.not. Tdomain%sFace(nf)%changing_media) cycle
            e0 = Tdomain%sFace(nf)%Near_Element(0)
            e1 = Tdomain%sFace(nf)%Near_Element(1)
            if (e0 < 0 .or. e1 < 0) cycle
            a0 = allocated(Tdomain%specel(e0)%AcoeffFl)
            a1 = allocated(Tdomain%specel(e1)%AcoeffFl)
            if (a0 .eqv. a1) cycle
            k = k + 1
            sfi(k)%nface = nf
            if (a0) then            ! e0 fluid, e1 solid
                sfi(k)%e_flu = e0; sfi(k)%e_sol = e1
            else
                sfi(k)%e_flu = e1; sfi(k)%e_sol = e0
            end if
            sfi(k)%ngll = Tdomain%sFace(nf)%ngll
            !!TODO: set wf_sol/wf_flu from Tdomain%sFace(nf)%Which_face(0/1) matched to e_sol/e_flu.
            !!TODO: fill is_sol/js_sol and is_flu/js_flu = the element (i,j) of each face GLL point
            !!      on each side, using the SEM2D face<->element local mapping (see get_iminimax in
            !!      Assemblage.F90 and the Which_face convention in global_numbering.F90).
            !!TODO: BtN(:,p) = outward normal (solid->fluid) at face GLL p * line-Jacobian * GLLw(p).
            !!      Reuse Tdomain%sFace(nf)%Normal if populated for CG; otherwise compute the normal
            !!      from the element geometry (InvGrad on the face) and the 1D arc-length Jacobian.
        end do
    end subroutine build_sf_interface_2d

    !-----------------------------------------------------------------------
    !> Apply the interface coupling each Newmark step (after internal forces, before
    !! the mass division / corrector). Mirror of SEM3D StoF + FtoS.
    !! REQUIRES: interface DOFs already separated (D4.0). Do NOT call otherwise.
    subroutine apply_sf_coupling_2d(Tdomain)
        type(domain), intent(inout) :: Tdomain
        integer :: m, p, isol, jsol, iflu, jflu
        real(fpp) :: vn, pf

        do m = 1, n_sfi
            do p = 0, sfi(m)%ngll-1
                isol = sfi(m)%is_sol(p); jsol = sfi(m)%js_sol(p)
                iflu = sfi(m)%is_flu(p); jflu = sfi(m)%js_flu(p)
                ! StoF: solid normal velocity drives the fluid potential equation.
                ! Approach A: solid velocity = Veloc(:,:,0:1); fluid RHS in Forces(:,:,0).
                vn = sfi(m)%BtN(0,p) * Tdomain%specel(sfi(m)%e_sol)%Veloc(isol,jsol,0) &
                   + sfi(m)%BtN(1,p) * Tdomain%specel(sfi(m)%e_sol)%Veloc(isol,jsol,1)
                Tdomain%specel(sfi(m)%e_flu)%Forces(iflu,jflu,0) = &
                     Tdomain%specel(sfi(m)%e_flu)%Forces(iflu,jflu,0) + vn
                ! FtoS: fluid pressure (= -VelPhi = -Veloc_fluid(:,:,0)) pushes the solid.
                pf = Tdomain%specel(sfi(m)%e_flu)%Veloc(iflu,jflu,0)   ! VelPhi
                Tdomain%specel(sfi(m)%e_sol)%Forces(isol,jsol,0) = &
                     Tdomain%specel(sfi(m)%e_sol)%Forces(isol,jsol,0) + sfi(m)%BtN(0,p)*pf
                Tdomain%specel(sfi(m)%e_sol)%Forces(isol,jsol,1) = &
                     Tdomain%specel(sfi(m)%e_sol)%Forces(isol,jsol,1) + sfi(m)%BtN(1,p)*pf
            end do
        end do
        !!TODO: verify signs/time-levels for energy consistency (compare to SEM3D StoF/FtoS
        !!      and the reflection/transmission gate in TESTS/aniso2d/README.md Test 4).
        !!TODO: this assumes e_sol/e_flu interior arrays carry the interface DOFs separately;
        !!      under shared CG faces (no D4.0 split) it is INCORRECT.
    end subroutine apply_sf_coupling_2d

end module solid_fluid_coupling_2d
