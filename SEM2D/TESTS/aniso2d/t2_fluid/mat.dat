# single medium, 20 x 12 Quad4 over [0,0.05]x[0,0.03]  (for MPI 4-rank tests)
0.0        # xmin
0.05       # xmax
0.0025     # xstep    -> nelemx = 20
0.03       # zmax
1          # nlayers
0.03 12    # layer 0: thickness  nsteps  -> nelemz = 12
0          # has_pml
0 0        # pml_top pml_bottom
0          # ngllPML
4          # mesh_type (Quad4)
