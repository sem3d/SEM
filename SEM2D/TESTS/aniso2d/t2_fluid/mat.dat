# 2D mat.dat for mesher2D on-the-fly (domain [0,0.05] x [0,0.03], 10 x 6 Quad4)
0.0        # xmin
0.05       # xmax
0.005      # xstep   -> nelemx = 10
0.03       # zmax (top of the layered column)
1          # nlayers (= number of materials used)
0.03 6     # layer 0: thickness  nsteps  -> nelemz = 6
0          # has_pml (0 = none)
0 0        # pml_top pml_bottom (dummy when has_pml=0)
0          # ngllPML            (dummy when has_pml=0)
4          # mesh_type (4 = Quad4)
